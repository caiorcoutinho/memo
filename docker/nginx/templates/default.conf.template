upstream django {
    server web:8000;
}

server {
    listen 80;
    server_name _;

    # Fotos originais de celular são grandes; o upload passa por aqui.
    client_max_body_size 100M;

    location /static/ {
        alias /var/www/static/;
        access_log off;
        expires ${STATIC_EXPIRES};
    }

    # As fotos vivem no MinIO; o nginx só repassa, para que a URL pública
    # continue sendo a do site e o MinIO não precise ser exposto.
    location /media/ {
        proxy_pass http://minio:9000/${MEDIA_BUCKET}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header x-amz-meta-server-side-encryption;
        expires ${MEDIA_EXPIRES};
    }

    location / {
        proxy_pass http://django;
        # $http_host é o Host que o navegador mandou, com a porta ("localhost:8080",
        # "192.168.0.10:8080"). O $host largaria a porta pelo caminho, e o Django
        # monta o endereço dos links públicos a partir daí — sem a porta o link
        # sai como "localhost/l/<token>/" e não abre. $server_port não serve:
        # aqui dentro o nginx escuta na 80, não na porta publicada no host.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
