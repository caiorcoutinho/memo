# Django
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,fofuchinha.caiorcoutinho.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://fofuchinha.caiorcoutinho.com.br

# Porta em que o nginx é publicado no host
HTTP_PORT=8080

# Postgres
POSTGRES_DB=memo
POSTGRES_USER=memo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha
MEDIA_BUCKET=media
# Endpoint interno usado pelo Django para falar com o MinIO
AWS_S3_ENDPOINT_URL=http://minio:9000
# URL pública das fotos (servida pelo nginx em /media/)
MEDIA_PUBLIC_URL=http://localhost:8080/media
